# Copiar a .env.local (desarrollo) y NUNCA commitear el archivo real.
# En producción: cargar estas mismas claves como GitHub Actions Secrets / variables de entorno del hosting.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Prohibido exponer con NEXT_PUBLIC_. Solo uso server-side (middleware, route handlers, jobs).
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloud name y upload preset UNSIGNED (docs/SETUP.md, sección Cloudinary):
# el navegador sube directo a Cloudinary sin pasar por nuestro backend ni
# exponer el API_SECRET. No son secretos — por eso van con NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=patitas_en_alerta_dev

# --- Upstash (Rate Limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- OpenAI (embeddings para búsqueda semántica de reportes similares) ---
OPENAI_API_KEY=sk-...

# --- Cifrado de datos sensibles (Node Crypto) ---
# Generar con: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# --- Jobs recurrentes (recordatorio de turnos, docs/SETUP.md Sección 7.2) ---
# Secreto compartido para autenticar al scheduler externo que dispara
# POST /api/webhooks/recordatorios-turnos (header x-cron-secret). Generar
# con: openssl rand -hex 32. Nunca reutilizar APP_ENCRYPTION_KEY.
CRON_JOBS_SECRET=

# --- Feature flags ---
# Historia clínica interoperable entre veterinarios (Módulo 6, docs/DECISIONES.md):
# deshabilitada hasta contar con el marco de responsabilidad profesional
# formalmente aprobado. Dejar en 'false' (o sin definir) en todo ambiente
# hasta nuevo aviso.
FEATURE_HISTORIALES_COMPARTIDOS=false

# --- CORS ---
# Lista separada por comas de orígenes permitidos en producción
CORS_ALLOWLIST=https://patitasenalerta.coronelpringles.gob.ar

# --- Observabilidad ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=patitas-en-alerta

# --- Entorno ---
NODE_ENV=development
